# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 내 PC에서 실행할 때만 필요합니다. 클라우드 세션에서는 비워 두세요.

# Claude API 키 (https://platform.claude.com 에서 발급) - 없으면 --no-ai 로만 실행됩니다
ANTHROPIC_API_KEY=

# 네이버 개발자센터 애플리케이션 (검색 API 사용 설정) - 없으면 가게 정보 자동 검색을 건너뜁니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: 사용할 Claude 모델과 생각 깊이(low / medium / high)
# BLOG_MODEL=claude-opus-5-5
# BLOG_EFFORT=medium
